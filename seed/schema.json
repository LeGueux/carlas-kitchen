{
  "version": "1",
  "defaultLocale": "en",
  "meta": { "name": "Carla's Kitchen", "description": "Personal recipe notebook schema. No example content is applied automatically." },
  "settings": { "title": "Carla’s Kitchen", "tagline": "A little notebook of good things." },
  "collections": [{
    "slug": "recipes", "label": "Recipes", "labelSingular": "Recipe", "icon": "cooking-pot",
    "description": "Personal recipes, photos and cooking notes. Up to three photos per recipe.",
    "supports": ["drafts", "revisions", "preview"], "commentsEnabled": false,
    "urlPattern": "/recipes/{slug}",
    "fields": [
      { "slug": "title", "label": "Title", "type": "string", "required": true, "searchable": true, "validation": { "maxLength": 160 } },
      { "slug": "description", "label": "Short description", "type": "text", "validation": { "maxLength": 600 }, "options": { "rows": 3 } },
      { "slug": "ingredients", "label": "Ingredients — one ingredient and quantity per line", "type": "text", "required": true, "options": { "rows": 10 }, "validation": { "maxLength": 12000 } },
      { "slug": "steps", "label": "Preparation — one step per line, in order", "type": "text", "required": true, "options": { "rows": 12 }, "validation": { "maxLength": 20000 } },
      { "slug": "prep_minutes", "label": "Preparation time (minutes, shared)", "type": "integer", "translatable": false, "defaultValue": 0, "validation": { "min": 0, "max": 10080 } },
      { "slug": "cook_minutes", "label": "Cooking time (minutes, shared)", "type": "integer", "translatable": false, "defaultValue": 0, "validation": { "min": 0, "max": 10080 } },
      { "slug": "servings", "label": "Servings (shared)", "type": "integer", "translatable": false, "defaultValue": 2, "validation": { "min": 1, "max": 100 } },
      { "slug": "rating", "label": "Personal rating out of 5 (optional, shared)", "type": "integer", "translatable": false, "validation": { "min": 1, "max": 5 } },
      { "slug": "notes", "label": "Personal review / cooking notes", "type": "text", "options": { "rows": 5 }, "validation": { "maxLength": 10000 } },
      { "slug": "last_cooked", "label": "Last cooked (optional, shared)", "type": "datetime", "translatable": false },
      { "slug": "source_url", "label": "Source URL (optional, shared)", "type": "url", "translatable": false },
      { "slug": "cover_image", "label": "Cover photo — 1 of 3 (shared)", "type": "image", "translatable": false, "validation": { "allowedMimeTypes": ["image/jpeg", "image/png", "image/webp"] } },
      { "slug": "photo_2", "label": "Gallery photo — 2 of 3 (shared)", "type": "image", "translatable": false, "validation": { "allowedMimeTypes": ["image/jpeg", "image/png", "image/webp"] } },
      { "slug": "photo_3", "label": "Gallery photo — 3 of 3 (shared)", "type": "image", "translatable": false, "validation": { "allowedMimeTypes": ["image/jpeg", "image/png", "image/webp"] } },
      { "slug": "is_example", "label": "Fictional example — display a notice (shared)", "type": "boolean", "translatable": false, "defaultValue": false }
    ]
  }],
  "taxonomies": [
    { "id": "categories-en", "name": "category", "label": "Categories", "labelSingular": "Category", "hierarchical": false, "collections": ["recipes"], "locale": "en" },
    { "id": "categories-fr", "translationOf": "categories-en", "name": "category", "label": "Catégories", "labelSingular": "Catégorie", "locale": "fr" },
    { "id": "categories-pt", "translationOf": "categories-en", "name": "category", "label": "Categorias", "labelSingular": "Categoria", "locale": "pt-PT" }
  ]
}
