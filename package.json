{
  "name": "carlas-kitchen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "emdash": {
    "seed": "seed/schema.json"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "postinstall": "node scripts/patch-emdash.mjs",
    "predev": "node scripts/patch-emdash.mjs",
    "prebuild": "node scripts/patch-emdash.mjs",
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/astro.mjs build",
    "check": "node scripts/astro.mjs check",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:init": "node --import tsx scripts/bootstrap.ts",
    "db:demo": "node --import tsx scripts/bootstrap.ts --demo",
    "db:migrate": "emdash migrate",
    "db:check": "emdash migrate --check"
  },
  "dependencies": {
    "@astrojs/netlify": "8.2.10",
    "@astrojs/react": "7.1.1",
    "@libsql/client": "0.18.0",
    "@netlify/blobs": "11.1.6",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "emdash": "1.3.1",
    "kysely": "0.29.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@lingui/core": "5.9.5",
    "@astrojs/check": "0.9.12",
    "@emdash-cms/auth": "1.3.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
