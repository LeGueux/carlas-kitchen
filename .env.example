# Development only. Create dedicated resources for this POC.
LIBSQL_DATABASE_URL=file:./data/kitchen.db
# LIBSQL_AUTH_TOKEN=fake-replace-with-a-dedicated-database-token-for-Turso
EMDASH_SITE_URL=http://localhost:4321
# Generate a random 32-byte key for each deployed environment; never commit it.
# EMDASH_ENCRYPTION_KEY=fake-generate-a-real-64-hex-key-locally
# Optional: block all CMS writes for a maintenance window.
KITCHEN_WRITES=enabled
# Runtime on Netlify: set AWS_LAMBDA_JS_RUNTIME=nodejs24.x in the Netlify UI.
# Blobs context is supplied by Netlify; do not put a personal Netlify token here.
