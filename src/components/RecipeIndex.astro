---
import Notebook from '../layouts/Notebook.astro';
import type { TaxonomyTerm } from 'emdash';
import { photoUrl, type Recipe } from '../lib/recipes';
import { localePath, type Locale } from '../config/locales';
import { ui } from '../i18n/ui';
interface Props { locale: Locale; query: string; category: string; recipes: Recipe[]; categories: TaxonomyTerm[]; }
const { locale, query, category, recipes, categories } = Astro.props;
const copy = ui[locale];
const categoryUrl = (slug = '') => { const params = new URLSearchParams(); if (slug) params.set('category', slug); if (query) params.set('q', query); return localePath(locale) + (params.size ? `?${params}` : ''); };
---
<Notebook locale={locale}>
  {Astro.url.searchParams.has('missing') && <aside class="notice" role="status">{copy.missing}</aside>}
  <section class="intro" aria-labelledby="notebook-title"><div><p class="eyebrow"><span aria-hidden="true">✳</span> {copy.notebook}</p><h1 id="notebook-title">{copy.hero.split('\n').map((line) => <span>{line}</span>)}</h1></div><p class="intro-note">{copy.intro}<span aria-hidden="true" class="note-flourish">↙</span></p></section>
  <section class="collection" aria-labelledby="collection-title">
    <div class="collection-heading"><h2 id="collection-title">{copy.recipes}</h2><span class="recipe-count">{recipes.length} {copy.count}</span></div>
    <form class="search-form" role="search" action={localePath(locale)}><div class="search-input"><label class="sr-only" for="search">{copy.search}</label><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 5 5"/></svg><input id="search" type="search" name="q" value={query} placeholder={copy.searchHint} maxlength="160" /></div>{category && <input type="hidden" name="category" value={category} />}<button type="submit">{copy.filter}<span aria-hidden="true"> →</span></button></form>
    <nav class="category-filters" aria-label={copy.category}><a class:list={{ active: !category }} aria-current={!category ? 'true' : undefined} href={categoryUrl()}>{copy.all}</a>{categories.map((term) => <a class:list={{ active: category === term.slug }} aria-current={category === term.slug ? 'true' : undefined} href={categoryUrl(term.slug)}>{term.label}</a>)}</nav>
    {recipes.length ? <div class="recipe-grid">{recipes.map((recipe, index) => { const src = photoUrl(recipe.cover_image); return <article class="recipe-card">
      <a class="card-photo" href={localePath(locale, `recipes/${encodeURIComponent(recipe.slug)}`)} tabindex="-1" aria-hidden="true">{src ? <img src={src} alt="" width="1200" height="900" loading={index > 1 ? 'lazy' : 'eager'} /> : <div class="photo-placeholder"><span aria-hidden="true">♧</span><span>{copy.noPhoto}</span></div>}{recipe.is_example && <span class="example-tag">{copy.example}</span>}</a>
      <div class="card-copy"><div class="card-kicker"><span>{recipe.terms?.category?.map((term) => term.label).join(' · ') || copy.notebook}</span><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span></div><h3><a href={localePath(locale, `recipes/${encodeURIComponent(recipe.slug)}`)}>{recipe.title}</a></h3>{recipe.description && <p class="card-description">{recipe.description}</p>}<div class="card-meta"><span>{(recipe.prep_minutes ?? 0) + (recipe.cook_minutes ?? 0)} {copy.minutes}</span>{recipe.rating && <span class="rating" aria-label={`${copy.rating}: ${recipe.rating}/5`}><span aria-hidden="true">★</span> {recipe.rating}<span class="muted"> / 5</span></span>}<span class="card-arrow" aria-hidden="true">↗</span></div></div>
    </article>; })}</div> : <div class="empty-state"><span aria-hidden="true">✳</span><h3>{copy.empty}</h3><p>{copy.emptyBody}</p>{(category || query) && <a class="text-link" href={localePath(locale)}>{copy.clear} →</a>}</div>}
  </section>
</Notebook>
