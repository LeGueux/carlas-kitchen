---
import type { Locale } from '../config/locales';
interface Props { locale: Locale; }
const { locale } = Astro.props;
---
<svg class="language-flag" viewBox="0 0 30 20" width="27" height="18" aria-hidden="true" focusable="false">
  {locale === 'en' && <>
    <path fill="#012169" d="M0 0h30v20H0z" />
    <path stroke="#fff" stroke-width="4" d="m0 0 30 20M30 0 0 20" />
    <path fill="#c8102e" d="m0 0 13 8.7h-3L0 2zm30 0L17 8.7h3L30 2zM0 20l13-8.7h-3L0 18zm30 0-13-8.7h3L30 18z" />
    <path stroke="#fff" stroke-width="7" d="M15 0v20M0 10h30" />
    <path stroke="#c8102e" stroke-width="4" d="M15 0v20M0 10h30" />
  </>}
  {locale === 'fr' && <>
    <path fill="#002654" d="M0 0h10v20H0z" />
    <path fill="#fff" d="M10 0h10v20H10z" />
    <path fill="#ed2939" d="M20 0h10v20H20z" />
  </>}
  {locale === 'pt-BR' && <>
    <path fill="#009739" d="M0 0h30v20H0z" />
    <path fill="#ffdf00" d="m15 2.5 12 7.5-12 7.5L3 10z" />
    <circle fill="#012169" cx="15" cy="10" r="4.6" />
    <path fill="#fff" d="M10.5 8.8a11 11 0 0 1 8.8 2.4l-.4 1.1a10 10 0 0 0-8.4-2.4z" />
    <g fill="#fff"><circle cx="13" cy="11.3" r=".35" /><circle cx="16" cy="12.4" r=".3" /><circle cx="15.2" cy="7.7" r=".3" /></g>
  </>}
</svg>
